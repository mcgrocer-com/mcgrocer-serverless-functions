# Shopify Store Configuration
# Your Shopify store name (without .myshopify.com)
# Example: if your store URL is mystore.myshopify.com, use: mystore
SHOPIFY_STORE_NAME=your_store_name

# Shopify Private App Access Token
# This token is generated when you create a private app in your Shopify admin
# Scopes needed: write_products, read_inventory
SHOPIFY_ACCESS_TOKEN=your_access_token_here
